#!/bin/bash
set -euo pipefail

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/hypr-rdp
RUN_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-rdp
PASSWORD_FILE=$RUN_DIR/password

[[ -s $CONF_DIR/tls.crt && -s $CONF_DIR/tls.key ]] || {
  echo "Remote Desktop is not configured. Run the plugin install.sh first." >&2
  exit 1
}
command -v hypr-rdp >/dev/null || {
  echo "hypr-rdp is not installed. Run the plugin install.sh first." >&2
  exit 1
}

PASSWORD=""
case "${1:-}" in
--password-stdin)
  IFS= read -r PASSWORD || true
  ;;
"")
  echo
  printf '  RDP password (user: %s)\n\n' "$(id -un)"
  while true; do
    read -rsp "  Password: " PASSWORD; echo
    read -rsp "  Confirm:  " CONFIRM; echo
    [[ ${#PASSWORD} -ge 12 ]] || { echo "  Use at least 12 characters."; continue; }
    [[ $PASSWORD == "$CONFIRM" ]] || { echo "  Passwords do not match."; continue; }
    break
  done
  ;;
*)
  echo "Usage: omarchy-rdp-password [--password-stdin]" >&2
  exit 2
  ;;
esac
[[ ${#PASSWORD} -ge 12 ]] || { echo "Error: use at least 12 characters." >&2; exit 1; }

# This is a separate RDP-only credential. It is never placed in argv and is
# not the account password, so compromise of the RDP process does not disclose
# a password that can authenticate to the local account or elevate privileges.
install -d -m 0700 "$RUN_DIR"
install -m 0600 /dev/null "$PASSWORD_FILE"
printf '%s\n' "$PASSWORD" >"$PASSWORD_FILE"
unset PASSWORD CONFIRM

BIND="127.0.0.1:3389"
OPTIONS=()
# shellcheck source=/dev/null
[[ -r $CONF_DIR/options ]] && source "$CONF_DIR/options"
PORT=${BIND##*:}

if ! systemctl --user restart hypr-rdp.service; then
  echo "The RDP service failed to start; stopping and disarming it." >&2
  "$HOME/.local/bin/omarchy-rdp-stop" >&2 || \
    echo "Could not confirm shutdown; inspect hypr-rdp.service immediately." >&2
  systemctl --user status --no-pager --lines=30 hypr-rdp.service >&2 || true
  exit 1
fi

READY=false
for _ in {1..50}; do
  if systemctl --user is-active --quiet hypr-rdp.service 2>/dev/null \
      && ss -ltnH "sport = :$PORT" 2>/dev/null | grep -q .; then
    READY=true
    break
  fi
  sleep 0.1
done
if ! $READY; then
  echo "RDP did not become active and listening; stopping it again." >&2
  "$HOME/.local/bin/omarchy-rdp-stop" >&2 || \
    echo "Could not confirm shutdown; inspect hypr-rdp.service immediately." >&2
  systemctl --user status --no-pager --lines=30 hypr-rdp.service >&2 || true
  exit 1
fi

if [[ $BIND == 127.0.0.1:* || $BIND == localhost:* ]]; then
  ENDPOINT=$BIND
else
  IP=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([^ ]*\).*/\1/p' | head -n1)
  [[ -n $IP ]] || IP=$(hostname -I 2>/dev/null | awk '{print $1}')
  ENDPOINT=${IP:-this-machine}:${BIND##*:}
fi
printf '\n  RDP is ready at %s\n  Sign in as: %s\n\n' "$ENDPOINT" "$(id -un)"
echo "  Rebooting forgets the RDP password. Run this command again to re-arm it."
